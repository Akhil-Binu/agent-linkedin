# LinkedBot Environment Configuration

# LLM Provider (Optional: GROK, GEMINI, OPENAI, ANTHROPIC, or LOCAL_MOCK)
LLM_PROVIDER=LOCAL_MOCK
GROK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LinkedIn Configuration
# Mode: "MOCK" for local sandbox, "BROWSER" for personal cookie session, "API" for REST API
LINKEDIN_MODE=MOCK
LINKEDIN_LI_AT=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# Human-In-The-Loop (HITL) Alerting Webhooks (Optional)
# e.g., https://hooks.slack.com/services/...
SLACK_WEBHOOK_URL=
# Telegram Bot Token & Chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Confidence Threshold for Auto-Action (percentage 0-100)
HITL_CONFIDENCE_THRESHOLD=85
